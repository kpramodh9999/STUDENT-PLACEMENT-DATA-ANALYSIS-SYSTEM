# Student Placement Data Analysis System - Database Configuration
# Set DB_TYPE to 'mysql' or 'sqlite'
# When set to 'mysql', ensure the MySQL server is running on 127.0.0.1:3306 with your password.
# If MySQL connection fails, the system automatically falls back to SQLite.
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=placement_system

# Flask Configuration
FLASK_ENV=development
PORT=5000
